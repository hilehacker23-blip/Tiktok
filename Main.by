import time
import requests

TELEGRAM_TOKEN = "8421996960:AAEVP7TVfbNgFqfIj3bcXkVMpW2aEpZsbNk"
CHANNEL_ID = "@ajinxaxa"

def send_telegram(message):
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {
        "chat_id": CHANNEL_ID,
        "text": message,
        "parse_mode": "Markdown"
    }
    try:
        requests.post(url, json=payload, timeout=5)
    except:
        pass

def check_tiktok():
    keywords = ["sandik", "hediye", "pk", "yayin"]
    for kw in keywords:
        try:
            url = f"https://www.tiktok.com/api/search/general/full/?keyword={kw}&offset=0"
            headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
            response = requests.get(url, headers=headers, timeout=4)
            if response.status_code == 200:
                data = response.json()
                for item in data.get("data", []):
                    author = item.get("item", {}).get("author", {}).get("uniqueId")
                    if author:
                        msg = f"🔥 **SANDIK BULUNDU!**\n\n• Yayıncı: `@{author}`\n• Link: https://www.tiktok.com/@{author}/live"
                        send_telegram(msg)
                        time.sleep(1)
        except:
            pass

if __name__ == "__main__":
    check_send = "🤖 **Cloud Sandık Botu Aktif!**\n\nSistem taramaya başladı, yayınlar taranıyor..."
    send_telegram(check_send)
    check_tiktok()
